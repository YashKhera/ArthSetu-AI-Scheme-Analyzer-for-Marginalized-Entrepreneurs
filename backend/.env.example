# Database
DATABASE_URL=postgresql://user:password@localhost/vittvaani

# JWT
SECRET_KEY=your-super-secret-key-min-32-chars-long-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_TOKEN_EXPIRE_MINUTES=30

# AI/LLM
AI_API_KEY=your-llm-api-key
AI_MODEL=gemini-3.1-pro

# Environment
ENVIRONMENT=development
DEBUG=true

# Frontend / Backend
FRONTEND_URL=http://127.0.0.1:5500/frontend
BACKEND_URL=http://localhost:8000

# Google OAuth (create creds at https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=